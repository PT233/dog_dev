digraph wsl_rpi_ros2_relationship {
  graph [
    rankdir=LR
    bgcolor="white"
    fontname="Helvetica"
    fontsize=12
    label="desktop_tracking_robot - WSL2 / Linux / ROS 2 / Nodes Relationship"
    labelloc=t
    labeljust=l
    nodesep=0.55
    ranksep=1.0
    pad=0.35
    splines=ortho
  ];

  node [
    shape=box
    style="rounded,filled"
    fontname="Helvetica"
    fontsize=10
    margin="0.14,0.10"
    color="#1f2937"
    fillcolor="#f8fafc"
    penwidth=1.15
  ];

  edge [
    fontname="Helvetica"
    fontsize=9
    color="#475569"
    fontcolor="#334155"
    penwidth=1.2
    arrowsize=0.8
  ];

  subgraph cluster_windows {
    label="Windows Host";
    color="#93c5fd";
    penwidth=1.4;
    style="rounded";

    windows_host [label="Windows 11 / Windows Terminal\n你看到的桌面和终端窗口", fillcolor="#dbeafe"];

    subgraph cluster_wsl {
      label="WSL2 VM";
      color="#60a5fa";
      penwidth=1.3;
      style="rounded";

      wsl_linux [label="Linux (Ubuntu in WSL2)\n这才是 ROS 2 真正运行的操作系统", fillcolor="#bfdbfe"];
      wsl_ros [label="ROS 2 Jazzy\nros2 CLI + rclcpp + CycloneDDS", fillcolor="#bfdbfe"];

      wsl_gst [label="gst_receiver_node", fillcolor="#dcfce7"];
      wsl_split [label="stereo_splitter_node", fillcolor="#dcfce7"];
      wsl_det [label="detection_node", fillcolor="#dcfce7"];
      wsl_track [label="tracker_node", fillcolor="#dcfce7"];
      wsl_beh [label="behavior_node", fillcolor="#dcfce7"];
      wsl_leg [label="leg_motion_node", fillcolor="#dcfce7"];
      wsl_viz [label="detection_viz_node\n可选调试节点", fillcolor="#fef3c7", color="#f59e0b"];
    }
  }

  subgraph cluster_rpi {
    label="Raspberry Pi";
    color="#86efac";
    penwidth=1.4;
    style="rounded";

    rpi_linux [label="Linux (Raspberry Pi OS / Ubuntu)\n另一个独立的 Linux 系统", fillcolor="#dcfce7"];
    rpi_ros [label="ROS 2 Jazzy\nros2 CLI + rclcpp + CycloneDDS", fillcolor="#bbf7d0"];
    rpi_camera [label="start_camera_stream.sh\n/dev/video0 -> UDP H.264:5600", fillcolor="#bbf7d0"];
    rpi_uart [label="uart_bridge_node", fillcolor="#bbf7d0"];
  }

  subgraph cluster_stm {
    label="STM32F103";
    color="#fca5a5";
    penwidth=1.4;
    style="rounded";

    stm_fw [label="裸机/RTOS 固件\nTask_UART_RX / Task_Traj_Planner\nTask_Status_TX / PWM", fillcolor="#fee2e2"];
    stm_servo [label="SG90 x4", shape=component, fillcolor="#fee2e2"];
  }

  windows_host -> wsl_linux [label="打开 WSL 终端\n进入 Linux 用户空间"];

  wsl_linux -> wsl_ros [label="ROS 2 安装在这个 Linux 里"];
  rpi_linux -> rpi_ros [label="ROS 2 也装在 Pi 的 Linux 里"];

  wsl_ros -> wsl_gst [label="ros2 run / ros2 launch"];
  wsl_ros -> wsl_split [label="节点都是 Linux 进程"];
  wsl_ros -> wsl_det;
  wsl_ros -> wsl_track;
  wsl_ros -> wsl_beh;
  wsl_ros -> wsl_leg;
  wsl_ros -> wsl_viz [style=dashed];

  rpi_ros -> rpi_uart [label="节点也是 Linux 进程"];

  rpi_camera -> wsl_gst [
    label="非 ROS 2 链路\nUDP / RTP H.264 :5600"
    color="#2563eb"
    fontcolor="#1d4ed8"
    penwidth=1.7
  ];

  wsl_gst -> wsl_split [label="/stereo/image_raw"];
  wsl_split -> wsl_det [label="/camera/image_mono"];
  wsl_det -> wsl_track [label="/detections"];
  wsl_track -> wsl_beh [label="/tracked_objects"];
  wsl_beh -> wsl_leg [label="/pixel_error"];
  wsl_track -> wsl_viz [label="/tracked_objects" style=dashed color="#d97706" fontcolor="#b45309"];
  wsl_split -> wsl_viz [label="/camera/image_mono" style=dashed color="#d97706" fontcolor="#b45309"];

  wsl_leg -> rpi_uart [
    label="ROS 2 DDS / RTPS 跨主机通信\n/servo_cmd"
    color="#059669"
    fontcolor="#047857"
    penwidth=1.8
  ];

  rpi_uart -> wsl_leg [
    label="ROS 2 DDS / RTPS 跨主机通信\n/servo_state"
    color="#7c3aed"
    fontcolor="#6d28d9"
    penwidth=1.8
  ];

  wsl_ros -> rpi_ros [
    label="同一个 ROS_DOMAIN_ID=42\n同一个 RMW_IMPLEMENTATION=rmw_cyclonedds_cpp\n通过 CycloneDDS peers 互相发现"
    color="#0f766e"
    fontcolor="#115e59"
    penwidth=1.8
  ];

  rpi_uart -> stm_fw [
    label="非 ROS 2 链路\nUART /dev/ttyAMA0 <-> USART1\n921600 8N1"
    color="#dc2626"
    fontcolor="#b91c1c"
    penwidth=1.8
  ];

  stm_fw -> stm_servo [label="PWM 输出"];
}
