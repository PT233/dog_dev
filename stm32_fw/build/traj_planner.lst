   8:Core/Src/traj_planner.c **** #define TRAJ_ACCEL_RATIO  0.3f
   9:Core/Src/traj_planner.c **** #define TRAJ_TICK_MS      5U
  10:Core/Src/traj_planner.c **** 
  11:Core/Src/traj_planner.c **** TrajState g_traj_state[TRAJ_SERVO_COUNT];
