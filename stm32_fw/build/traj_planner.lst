  31:Core/Src/traj_planner.c **** 
  32:Core/Src/traj_planner.c **** void Traj_SetTarget(uint8_t id, float target_deg, uint16_t duration_ms)
  33:Core/Src/traj_planner.c **** {
  34:Core/Src/traj_planner.c ****     if (id >= TRAJ_SERVO_COUNT) {
  35:Core/Src/traj_planner.c ****         return;
  36:Core/Src/traj_planner.c ****     }
  37:Core/Src/traj_planner.c **** 
  38:Core/Src/traj_planner.c ****     float dist = target_deg - g_traj_state[id].current_angle;
  39:Core/Src/traj_planner.c ****     float T    = (float)duration_ms / 1000.0f;
  40:Core/Src/traj_planner.c **** 
  41:Core/Src/traj_planner.c ****     g_traj_state[id].target_angle = target_deg;
  42:Core/Src/traj_planner.c ****     g_traj_state[id].duration_ms  = duration_ms;
  43:Core/Src/traj_planner.c ****     g_traj_state[id].start_tick   = HAL_GetTick();
  44:Core/Src/traj_planner.c ****     g_traj_state[id].velocity     = 0.0f;
  45:Core/Src/traj_planner.c ****     s_start_angle[id]             = g_traj_state[id].current_angle;
  46:Core/Src/traj_planner.c **** 
  47:Core/Src/traj_planner.c ****     if (T > 0.001f && fabsf(dist) > 0.01f) {
  48:Core/Src/traj_planner.c ****         /* Symmetric trapezoid: V_max = D / (T * (1 - r)), a = V_max / (T * r) */
  49:Core/Src/traj_planner.c ****         s_v_max[id]                  = dist / (T * (1.0f - TRAJ_ACCEL_RATIO));
  50:Core/Src/traj_planner.c ****         g_traj_state[id].max_accel   = s_v_max[id] / (T * TRAJ_ACCEL_RATIO);
  51:Core/Src/traj_planner.c ****     } else {
  52:Core/Src/traj_planner.c ****         /* Negligible distance or zero duration: snap immediately */
  53:Core/Src/traj_planner.c ****         s_v_max[id]                  = 0.0f;
  54:Core/Src/traj_planner.c ****         g_traj_state[id].max_accel   = 0.0f;
  55:Core/Src/traj_planner.c ****         g_traj_state[id].current_angle = target_deg;
  56:Core/Src/traj_planner.c ****         g_traj_state[id].duration_ms   = 0U;
  57:Core/Src/traj_planner.c ****         Servo_SetAngle(id, target_deg);
  58:Core/Src/traj_planner.c ****     }
  59:Core/Src/traj_planner.c **** }
