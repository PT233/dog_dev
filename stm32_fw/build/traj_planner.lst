  23:Core/Src/traj_planner.c ****         g_traj_state[i].velocity      = 0.0f;
  24:Core/Src/traj_planner.c ****         g_traj_state[i].max_accel     = 0.0f;
  25:Core/Src/traj_planner.c ****         g_traj_state[i].start_tick    = 0U;
  26:Core/Src/traj_planner.c ****         g_traj_state[i].duration_ms   = 0U;
