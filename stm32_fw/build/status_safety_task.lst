  10:Core/Src/status_safety_task.c **** 
  11:Core/Src/status_safety_task.c **** #define STATUS_TX_PERIOD_MS  50U
  12:Core/Src/status_safety_task.c **** #define SAFETY_PERIOD_MS     100U
  13:Core/Src/status_safety_task.c **** 
  14:Core/Src/status_safety_task.c **** /* Frame = header(2) + cmd(1) + len(1) + payload(N) + crc(2) + tail(1) */
  15:Core/Src/status_safety_task.c **** #define STATUS_PAYLOAD_LEN  ((uint8_t)(TRAJ_SERVO_COUNT * sizeof(ServoStateItem)))
  16:Core/Src/status_safety_task.c **** #define STATUS_FRAME_LEN    ((uint8_t)(7U + STATUS_PAYLOAD_LEN))
  17:Core/Src/status_safety_task.c **** 
  18:Core/Src/status_safety_task.c **** /* Pack and transmit a CMD_ID=0x81 status frame with current servo angles */
  19:Core/Src/status_safety_task.c **** static void StatusTX_SendFrame(void)
  20:Core/Src/status_safety_task.c **** {
  21:Core/Src/status_safety_task.c ****     uint8_t tx_buf[STATUS_FRAME_LEN];
  22:Core/Src/status_safety_task.c ****     uint16_t crc;
  23:Core/Src/status_safety_task.c ****     uint8_t i;
  24:Core/Src/status_safety_task.c **** 
  25:Core/Src/status_safety_task.c ****     tx_buf[0] = UART_FRAME_HEADER_0;
  26:Core/Src/status_safety_task.c ****     tx_buf[1] = UART_FRAME_HEADER_1;
  27:Core/Src/status_safety_task.c ****     tx_buf[2] = (uint8_t)UART_CMD_SERVO_STATE;
  28:Core/Src/status_safety_task.c ****     tx_buf[3] = STATUS_PAYLOAD_LEN;
  29:Core/Src/status_safety_task.c **** 
  30:Core/Src/status_safety_task.c ****     for (i = 0U; i < TRAJ_SERVO_COUNT; i++) {
  31:Core/Src/status_safety_task.c ****         ServoStateItem item;
  32:Core/Src/status_safety_task.c ****         item.servo_id           = i;
  33:Core/Src/status_safety_task.c ****         item.current_angle_x10  = (int16_t)(g_traj_state[i].current_angle * 10.0f);
ARM GAS  /tmp/ccglfN4V.s 			page 2


  34:Core/Src/status_safety_task.c ****         item.status             = (g_traj_state[i].duration_ms > 0U) ? 1U : 0U;
  35:Core/Src/status_safety_task.c ****         memcpy(&tx_buf[4U + (uint8_t)(i * sizeof(ServoStateItem))], &item, sizeof(ServoStateItem));
  36:Core/Src/status_safety_task.c ****     }
  37:Core/Src/status_safety_task.c **** 
  38:Core/Src/status_safety_task.c ****     crc = crc16_ccitt(&tx_buf[2], (size_t)(2U + STATUS_PAYLOAD_LEN));
  39:Core/Src/status_safety_task.c ****     tx_buf[4U + STATUS_PAYLOAD_LEN] = (uint8_t)(crc & 0xFFU);
  40:Core/Src/status_safety_task.c ****     tx_buf[5U + STATUS_PAYLOAD_LEN] = (uint8_t)(crc >> 8);
  41:Core/Src/status_safety_task.c ****     tx_buf[6U + STATUS_PAYLOAD_LEN] = UART_FRAME_TAIL;
  42:Core/Src/status_safety_task.c **** 
  43:Core/Src/status_safety_task.c ****     /* Blocking transmit: 23 bytes @ 921600 bps ≈ 0.25ms */
  44:Core/Src/status_safety_task.c ****     HAL_UART_Transmit(&huart1, tx_buf, STATUS_FRAME_LEN, 10U);
  45:Core/Src/status_safety_task.c **** }
  46:Core/Src/status_safety_task.c **** 
  47:Core/Src/status_safety_task.c **** /* 20Hz status reporter: packs 4-servo state into 0x81 frame and sends via UART */
  48:Core/Src/status_safety_task.c **** static void Task_Status_TX(void *arg)
  49:Core/Src/status_safety_task.c **** {
  50:Core/Src/status_safety_task.c ****     (void)arg;
  51:Core/Src/status_safety_task.c ****     for (;;) {
  52:Core/Src/status_safety_task.c ****         osDelay(STATUS_TX_PERIOD_MS);
  53:Core/Src/status_safety_task.c ****         StatusTX_SendFrame();
  54:Core/Src/status_safety_task.c ****     }
  55:Core/Src/status_safety_task.c **** }
  56:Core/Src/status_safety_task.c **** 
  57:Core/Src/status_safety_task.c **** /* Safety watchdog feeder: feeds IWDG every 100ms.
  58:Core/Src/status_safety_task.c ****  * Servo position is held automatically when no new Traj_SetTarget is called. */
